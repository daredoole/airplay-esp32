# Generic ESP32-WROOM / DevKit with 4MB flash and no external PSRAM.
CONFIG_BOARD_ESP32_GENERIC=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions-4m.csv"
# CONFIG_SPIRAM is not set
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set

# PCM5102A I2S defaults for classic ESP32 boards.
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=33
CONFIG_I2S_WS_IO=25
CONFIG_I2S_DO_IO=32
CONFIG_DAC_I2C_SDA=-1
CONFIG_DAC_I2C_SCL=-1
CONFIG_SPDIF_DO_IO=-1

# No display or onboard status LED is assumed on a generic DevKit.
# CONFIG_DISPLAY_ENABLED is not set
CONFIG_LED_STATUS_GPIO=-1
CONFIG_LED_ERROR_GPIO=-1
CONFIG_LED_RGB_GPIO=-1

# The BOOT button can still provide mute / play-pause.
CONFIG_BTN_PLAY_PAUSE_GPIO=0
